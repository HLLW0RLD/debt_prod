{
  "schemaVersion": 1,
  "screenId": "debt_details",
  "title": "Детали долга",
  "appBar": {
    "type": "default",
    "title": "{{record.debtorName}}",
    "showBackButton": true,
    "backIcon": "arrow_left",
    "isCentered": true,
    "showDivider": true,
    "optionsMode": "button",
    "optionsIcon": "ic_options",
    "action": {
      "type": "navigate",
      "destination": "create_debt"
    }
  },
  "body": {
    "type": "column",
    "padding": 16,
    "spacing": 16,
    "children": [
      {
        "type": "card",
        "padding": 20,
        "spacing": 10,
        "cornerRadius": 20,
        "elevation": 2,
        "children": [
          {
            "type": "text_view_default",
            "text": "Должник",
            "fontSize": 13,
            "color": "textSecondary"
          },
          {
            "type": "text_view_default",
            "text": "{{record.debtorName}}",
            "fontSize": 24,
            "fontWeight": "bold"
          },
          {
            "type": "text_view_default",
            "text": "Сумма",
            "fontSize": 13,
            "color": "textSecondary"
          },
          {
            "type": "text_view_default",
            "text": "{{record.amount}} ₽",
            "fontSize": 28,
            "fontWeight": "bold",
            "color": "#167D58"
          },
          {
            "type": "text_view_default",
            "text": "Срок: {{record.dueDate}}",
            "fontSize": 15
          },
          {
            "type": "text_view_default",
            "text": "{{record.note}}",
            "fontSize": 15
          }
        ]
      },
      {
        "type": "button_text_default",
        "text": "Редактировать (форма)",
        "containerColor": "#167D58",
        "action": {
          "type": "navigate",
          "destination": "edit_debt",
          "args": {
            "id": "{{record.id}}",
            "debtorName": "{{record.debtorName}}",
            "amount": "{{record.amount}}",
            "dueDate": "{{record.dueDate}}",
            "note": "{{record.note}}",
            "currency": "{{record.currency}}",
            "direction": "{{record.direction}}",
            "remind": "{{record.remind}}"
          }
        }
      },
      {
        "type": "button_text_ghost",
        "text": "К списку долгов",
        "action": {
          "type": "navigate",
          "destination": "debts"
        }
      }
    ]
  }
}