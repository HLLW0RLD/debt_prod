{
  "schemaVersion": 1,
  "screenId": "profile",
  "title": "Профиль",
  "appBar": {
    "type": "default",
    "title": "Профиль",
    "showBackButton": false,
    "isCentered": true,
    "showDivider": true,
    "optionsMode": "button",
    "optionsIcon": "switcher_options",
    "action": {
      "type": "navigate",
      "destination": "edit_profile",
      "args": {
        "name": "{{name}}"
      }
    }
  },
  "bottomBar": {
    "backgroundColor": "#302f2f",
    "selectedColor": "#167D58",
    "unselectedColor": "#808080",
    "selectedItem": "profile",
    "items": [
      {
        "id": "home",
        "label": "Главная",
        "icon": "ic_wallet_up",
        "action": {
          "type": "navigate",
          "destination": "home"
        }
      },
      {
        "id": "debts",
        "label": "Долги",
        "icon": "ic_money",
        "action": {
          "type": "navigate",
          "destination": "debts"
        }
      },
      {
        "id": "profile",
        "label": "Профиль",
        "icon": "profile",
        "action": {
          "type": "navigate",
          "destination": "profile",
          "args": {
            "name": "{{name}}"
          }
        }
      },
      {
        "id": "feedback",
        "label": "Отзыв",
        "icon": "ic_options",
        "action": {
          "type": "navigate",
          "destination": "feedback"
        }
      }
    ]
  },
  "body": {
    "type": "column",
    "padding": 16,
    "spacing": 16,
    "children": [
      {
        "type": "card",
        "padding": 20,
        "spacing": 8,
        "cornerRadius": 20,
        "children": [
          {
            "type": "text_view_default",
            "text": "Привет, {{name}}",
            "fontSize": 24,
            "fontWeight": "bold"
          },
          {
            "type": "text_view_default",
            "text": "Аргумент пришёл из navigate.args",
            "fontSize": 14
          }
        ]
      },
      {
        "type": "selection_switch_default",
        "stateKey": "notifications",
        "text": "Уведомления о сроках",
        "checked": true,
        "checkedColor": "#167D58"
      },
      {
        "type": "selection_switch_default",
        "stateKey": "darkHint",
        "text": "Тёмная тема (демо state)",
        "checked": false,
        "checkedColor": "#167D58"
      },
      {
        "type": "button_text_default",
        "text": "К списку долгов",
        "containerColor": "#167D58",
        "action": {
          "type": "navigate",
          "destination": "debts"
        }
      }
    ]
  }
}