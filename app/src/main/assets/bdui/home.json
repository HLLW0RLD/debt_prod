
{
  "schemaVersion": 1,
  "screenId": "home",
  "title": "Главная",
  "appBar": {
    "type": "default",
    "title": "BDUI Playground",
    "showBackButton": false,
    "isCentered": true,
    "showDivider": true,
    "height": 64,
    "textSize": 22,
    "optionsMode": "menu",
    "optionsIcon": "more_vert",
    "options": [
      {
        "label": "Профиль",
        "action": {
          "type": "navigate",
          "destination": "profile",
          "args": {
            "name": "Тестовый пользователь"
          }
        }
      },
      {
        "label": "Каталог",
        "action": {
          "type": "navigate",
          "destination": "catalog"
        }
      },
      {
        "label": "Обратная связь",
        "action": {
          "type": "navigate",
          "destination": "feedback"
        }
      }
    ]
  },
  "bottomBar": {
    "selectedItem": "home",
    "items": [
      {
        "id": "home",
        "label": "Главная",
        "icon": "home",
        "action": {
          "type": "navigate",
          "destination": "home"
        }
      },
      {
        "id": "profile",
        "label": "Профиль",
        "icon": "person",
        "action": {
          "type": "navigate",
          "destination": "profile",
          "args": {
            "name": "Тестовый пользователь"
          }
        }
      },
      {
        "id": "catalog",
        "label": "Каталог",
        "icon": "search",
        "action": {
          "type": "navigate",
          "destination": "catalog"
        }
      }
    ]
  },
  "body": {
    "type": "column",
    "padding": 16,
    "spacing": 16,
    "children": [
      {
        "type": "text_view_default",
        "text": "BDUI Playground",
        "fontSize": 26,
        "fontWeight": "bold",
        "textAlign": "start"
      },
      {
        "type": "text_view_default",
        "text": "Тестирование компонентов и настроек интерфейса",
        "fontSize": 15
      },
      {
        "type": "card",
        "padding": 16,
        "spacing": 12,
        "cornerRadius": 20,
        "elevation": 2,
        "backgroundColor": "#FFFFFF",
        "children": [
          {
            "type": "text_view_default",
            "text": "Переход между экранами",
            "fontSize": 18,
            "fontWeight": "bold"
          },
          {
            "type": "textField",
            "stateKey": "userName",
            "label": "Имя для передачи",
            "width": "match_parent"
          },
          {
            "type": "button_text_default",
            "text": "Открыть профиль",
            "height": 48,
            "cornerRadius": 12,
            "action": {
              "type": "navigate",
              "destination": "profile",
              "args": {
                "name": "$userName"
              }
            }
          }
        ]
      },
      {
        "type": "button_text_ghost",
        "text": "Открыть каталог",
        "action": {
          "type": "navigate",
          "destination": "catalog"
        }
      },
      {
        "type": "button_text_ghost",
        "text": "Открыть форму",
        "action": {
          "type": "navigate",
          "destination": "feedback"
        }
      }
    ]
  }
}
