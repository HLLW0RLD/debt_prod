{
  "schemaVersion": 1,
  "screenId": "debts",
  "title": "Долги",
  "appBar": {
    "type": "search",
    "showBackButton": false,
    "valueKey": "searchQuery",
    "placeholder": "Поиск по имени",
    "showDivider": true
  },
  "bottomBar": {
    "selectedItem": "debts",
    "backgroundColor": "#302f2f",
    "selectedColor": "#167D58",
    "unselectedColor": "#808080",
    "items": [
      {
        "id": "home",
        "label": "Главная",
        "icon": "ic_wallet_up",
        "action": {
          "type": "navigate",
          "destination": "home"
        }
      },
      {
        "id": "debts",
        "label": "Долги",
        "icon": "ic_money",
        "action": {
          "type": "navigate",
          "destination": "debts"
        }
      },
      {
        "id": "profile",
        "label": "Профиль",
        "icon": "profile",
        "action": {
          "type": "navigate",
          "destination": "profile",
          "args": {
            "name": "Иван"
          }
        }
      }
    ]
  },
  "body": {
    "type": "column",
    "children": [
      {
        "type": "text_view_default",
        "text": "Активные",
        "fontSize": 20,
        "padding": 16,
        "fontWeight": "bold"
      },
      {
        "type": "button_floating_action",
        "visible": true,
        "icon": "add_debt",
        "containerColor": "#167D58",
        "contentColor": "#FFFFFF",
        "enterDelay": 0,
        "startOffsetDp": 80,
        "size": 56,
        "iconSize": 24,
        "cornerRadius": 28,
        "action": {
          "type": "navigate",
          "destination": "create_debt"
        }
      },
      {
        "type": "lazy_column",
        "source": "records",
        "padding": 16,
        "spacing": 12,
        "reverseLayout": false,
        "children": [
          {
            "type": "card",
            "padding": 14,
            "spacing": 8,
            "cornerRadius": 16,
            "children": [
              {
                "type": "text_view_default",
                "text": "{{item.debtorName}}",
                "fontSize": 17,
                "fontWeight": "bold"
              },
              {
                "type": "text_view_default",
                "text": "{{item.amount}} ₽ · до {{item.dueDate}}",
                "fontSize": 14
              },
              {
                "type": "button_text_ghost",
                "text": "Открыть",
                "contentColor": "#167D58",
                "action": {
                  "type": "navigate",
                  "destination": "debt_details",
                  "args": {
                    "id": "{{item.id}}",
                    "debtorName": "{{item.debtorName}}",
                    "amount": "{{item.amount}}",
                    "dueDate": "{{item.dueDate}}",
                    "note": "{{item.note}}",
                    "currency": "{{item.currency}}",
                    "direction": "{{item.direction}}",
                    "remind": "{{item.remind}}"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}