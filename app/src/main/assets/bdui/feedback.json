{
  "schemaVersion": 1,
  "screenId": "feedback",
  "title": "Обратная связь",
  "appBar": {
    "type": "default",
    "title": "Обратная связь",
    "showBackButton": false,
    "isCentered": true,
    "showDivider": true
  },
  "bottomBar": {
    "backgroundColor": "#302f2f",
    "selectedColor": "#167D58",
    "unselectedColor": "#808080",
    "selectedItem": "feedback",
    "items": [
      {
        "id": "home",
        "label": "Главная",
        "icon": "ic_wallet_up",
        "action": {
          "type": "navigate",
          "destination": "home"
        }
      },
      {
        "id": "debts",
        "label": "Долги",
        "icon": "ic_money",
        "action": {
          "type": "navigate",
          "destination": "debts"
        }
      },
      {
        "id": "profile",
        "label": "Профиль",
        "icon": "profile",
        "action": {
          "type": "navigate",
          "destination": "profile",
          "args": {
            "name": "{{name}}"
          }
        }
      },
      {
        "id": "feedback",
        "label": "Отзыв",
        "icon": "ic_options",
        "action": {
          "type": "navigate",
          "destination": "feedback"
        }
      }
    ]
  },
  "body": {
    "type": "column",
    "padding": 16,
    "spacing": 16,
    "children": [
      {
        "type": "text_view_default",
        "text": "Поделитесь мнением",
        "fontSize": 24,
        "fontWeight": "bold"
      },
      {
        "type": "text_view_default",
        "text": "Ваши предложения помогут сделать приложение удобнее",
        "fontSize": 15
      },
      {
        "type": "card",
        "padding": 16,
        "spacing": 14,
        "cornerRadius": 18,
        "children": [
          {
            "type": "field_input_outlined",
            "stateKey": "feedbackName",
            "label": "Ваше имя"
          },
          {
            "type": "field_input_outlined",
            "stateKey": "feedbackSubject",
            "label": "Тема обращения"
          },
          {
            "type": "field_input_outlined",
            "stateKey": "feedbackMessage",
            "label": "Ваш отзыв",
            "singleLine": false,
            "minLines": 4,
            "maxLines": 8
          },
          {
            "type": "button_text_default",
            "text": "Отправить отзыв",
            "containerColor": "#167D58"
          }
        ]
      },
      {
        "type": "button_text_ghost",
        "text": "На главную",
        "contentColor": "#167D58",
        "action": {
          "type": "navigate",
          "destination": "home"
        }
      }
    ]
  }
}